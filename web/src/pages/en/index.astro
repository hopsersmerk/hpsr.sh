---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navbar from '../../components/Navbar.astro'
import Hero from '../../components/Hero.astro'
import HardeningBlueprint from '../../components/HardeningBlueprint.astro'
import ComparisonMatrix from '../../components/ComparisonMatrix.astro'
import TerminalPreview from '../../components/TerminalPreview.astro'
import VerificationSection from '../../components/VerificationSection.astro'
import FaqSection from '../../components/FaqSection.astro'
import CtaBanner from '../../components/CtaBanner.astro'
import Footer from '../../components/Footer.astro'
import { content } from '../../lib/content'

const c = content.en
---

<BaseLayout lang="en" content={c}>
  <Navbar lang="en" nav={c.nav} />
  <main id="main-content">
    <Hero
      lang="en"
      eyebrow={c.hero.eyebrow}
      title={c.hero.title}
      titleAccent={c.hero.titleAccent}
      description={c.hero.description}
      note={c.hero.note}
      secondaryCta={c.hero.secondaryCta}
      stats={c.hero.stats}
      platformsTitle={c.hero.platformsTitle}
      platforms={c.hero.platforms}
      commandHint={c.hero.commandHint}
      actions={c.actions}
    />

    <HardeningBlueprint
      badge={c.blueprint.badge}
      title={c.blueprint.title}
      description={c.blueprint.description}
      layers={c.blueprint.layers}
    />

    <ComparisonMatrix
      badge={c.comparison.badge}
      title={c.comparison.title}
      description={c.comparison.description}
      headers={c.comparison.headers}
      rows={c.comparison.rows}
    />

    <TerminalPreview
      badge={c.terminal.badge}
      title={c.terminal.title}
      description={c.terminal.description}
      lang="en"
      replayText={c.terminal.replay}
      copyOutputText={c.terminal.copyOutput}
    />

    <VerificationSection
      badge={c.verification.badge}
      title={c.verification.title}
      description={c.verification.description}
      items={c.verification.items}
    />

    <FaqSection
      badge={c.faq.badge}
      title={c.faq.title}
      description={c.faq.description}
      items={c.faq.items}
    />

    <CtaBanner
      title={c.ctaBanner.title}
      description={c.ctaBanner.description}
      primaryCta={c.ctaBanner.primaryCta}
      githubCta={c.ctaBanner.githubCta}
      copiedText={c.actions.copied}
    />
  </main>
  <Footer
    tagline={c.footer.tagline}
    copyright={c.footer.copyright}
    authorText={c.footer.authorText}
    status={c.footer.status}
    links={c.footer.links}
  />
</BaseLayout>
