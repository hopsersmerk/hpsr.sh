---
import type { Language, Content } from '../lib/content'
import '../styles/global.css'

interface Props {
  lang: Language
  content: Content
}

const { lang, content } = Astro.props

const siteUrl = 'https://sh.hpsr.dev'
const pageUrl = lang === 'es' ? siteUrl : `${siteUrl}/en`
const ogImageUrl = `${siteUrl}/og-image.png`

// Structured data for SEO (Rich Snippets, SoftwareApplication, FAQPage, HowTo)
const structuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'hpsr.sh',
    url: siteUrl,
    inLanguage: ['es', 'en'],
    description: content.meta.description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'hpsr.sh',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Debian, Ubuntu, Linux',
    softwareVersion: '0.2.0',
    url: siteUrl,
    downloadUrl: `${siteUrl}/setup.sh`,
    image: ogImageUrl,
    description: content.meta.description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    author: {
      '@type': 'Person',
      name: 'hopsersmerk',
      url: 'https://hopsersmerk.com'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a
      }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: lang === 'es' ? 'Cómo hacer setup inicial y hardening de un VPS Debian o Ubuntu' : 'How to perform initial setup and hardening on a Debian or Ubuntu VPS',
    description: content.meta.description,
    step: [
      {
        '@type': 'HowToStep',
        name: lang === 'es' ? 'Conéctate a tu VPS por SSH como root' : 'Connect to your VPS via SSH as root',
        text: 'ssh root@TU_IP'
      },
      {
        '@type': 'HowToStep',
        name: lang === 'es' ? 'Ejecuta el comando del asistente' : 'Run the installer command',
        text: 'curl -fsSL https://sh.hpsr.dev/setup.sh | bash'
      },
      {
        '@type': 'HowToStep',
        name: lang === 'es' ? 'Sigue los pasos interactivos del asistente' : 'Follow the interactive prompts',
        text: lang === 'es' ? 'Configura usuario no-root, llaves SSH, puerto custom, firewall UFW y Fail2ban' : 'Configure non-root user, SSH keys, custom port, UFW firewall, and Fail2ban'
      },
      {
        '@type': 'HowToStep',
        name: lang === 'es' ? 'Prueba la nueva sesión y guarda el reporte' : 'Test new connection and save the report',
        text: lang === 'es' ? 'Prueba el acceso en una nueva terminal antes de cerrar la sesión root' : 'Test access in a new terminal window before closing your root session'
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'hpsr.sh',
    url: siteUrl,
    logo: `${siteUrl}/logo.png`,
    sameAs: ['https://github.com/hopsersmerk/hpsr.sh', 'https://hopsersmerk.com', 'https://hpsr.mx']
  }
])
---

<!doctype html>
<html lang={lang} color-scheme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <meta name="keywords" content={content.meta.keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="application-name" content="hpsr.sh" />
    <meta name="theme-color" content="#09090b" />

    <!-- OpenGraph / Social Metadata -->
    <meta property="og:site_name" content="hpsr.sh" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.title} />
    <meta name="twitter:description" content={content.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Canonical and Reciprocal Hreflang Tags for SEO -->
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="es" href="https://sh.hpsr.dev/" />
    <link rel="alternate" hreflang="en" href="https://sh.hpsr.dev/en" />
    <link rel="alternate" hreflang="x-default" href="https://sh.hpsr.dev/" />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Plausible Analytics -->
    <script is:inline async src="https://analytics.hpsr.dev/js/pa-InPZ8rwjg6QSZw694Tnpp.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <!-- Schema.org JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={structuredData}></script>

    <!-- Theme initialization script (Dark-first, prevents flash) -->
    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem('hpsr-theme')
          const scheme = stored ? stored : 'dark'
          document.documentElement.setAttribute('color-scheme', scheme)
          const metaTheme = document.querySelector('meta[name="theme-color"]')
          if (metaTheme) {
            metaTheme.setAttribute('content', scheme === 'dark' ? '#09090b' : '#fafafa')
          }
        } catch (_) {}
      })()
    </script>
  </head>
  <body>
    <div class="page-shell">
      <div class="ambient-glow" aria-hidden="true"></div>
      <slot />
    </div>

    <!-- Global Client Interactions -->
    <script is:inline>
      ;(() => {
        const THEME_KEY = 'hpsr-theme'

        const bindThemeToggle = () => {
          const toggle = document.getElementById('theme-toggle')
          if (!toggle) return

          toggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('color-scheme') || 'dark'
            const next = current === 'dark' ? 'light' : 'dark'

            document.documentElement.setAttribute('color-scheme', next)
            try {
              localStorage.setItem(THEME_KEY, next)
            } catch (_) {}

            const metaTheme = document.querySelector('meta[name="theme-color"]')
            if (metaTheme) {
              metaTheme.setAttribute('content', next === 'dark' ? '#09090b' : '#fafafa')
            }
          })
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindThemeToggle, { once: true })
        } else {
          bindThemeToggle()
        }
      })()
    </script>
  </body>
</html>
