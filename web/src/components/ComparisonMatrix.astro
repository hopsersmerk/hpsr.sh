---
import type { ComparisonRow } from '../lib/content'

interface Props {
  badge: string
  title: string
  description: string
  headers: [string, string, string, string]
  rows: ComparisonRow[]
}

const { badge, title, description, headers, rows } = Astro.props
---

<section class="section comparison-section" id="comparison">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-dot"></span>
        <span>{badge}</span>
      </div>
      <h2 class="section-title">{title}</h2>
      <p class="section-description">{description}</p>
    </div>

    <div class="comparison-table-wrapper">
      <span class="corner-plus corner-tl" aria-hidden="true">+</span>
      <span class="corner-plus corner-tr" aria-hidden="true">+</span>
      <span class="corner-plus corner-bl" aria-hidden="true">+</span>
      <span class="corner-plus corner-br" aria-hidden="true">+</span>

      <div class="table-scroll-container">
        <table class="comparison-table">
          <thead>
            <tr>
              <th class="col-feature">{headers[0]}</th>
              <th class="col-manual">{headers[1]}</th>
              <th class="col-hpsr featured-header">
                <span class="featured-badge">RECOMENDADO</span>
                {headers[2]}
              </th>
              <th class="col-ansible">{headers[3]}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td class="cell-feature">
                  <strong>{row.feature}</strong>
                </td>
                <td class="cell-manual">
                  <span class="status-cross" aria-hidden="true">✕</span>
                  <span>{row.manual}</span>
                </td>
                <td class="cell-hpsr featured-cell">
                  <span class="status-check" aria-hidden="true">✓</span>
                  <span>{row.hpsr}</span>
                </td>
                <td class="cell-ansible">
                  <span class="status-neutral" aria-hidden="true">~</span>
                  <span>{row.ansible}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    position: relative;
    padding: 10rem 0;
  }

  .comparison-table-wrapper {
    position: relative;
    margin-top: 5rem;
    border-radius: var(--radius-m);
    border: 1px solid var(--border-strong);
    background: var(--panel);
    overflow: hidden;
  }

  .table-scroll-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.4rem;
    text-align: left;
    min-width: 680px;
  }

  .comparison-table th {
    padding: 2rem 2.2rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-strong);
    background: var(--panel-strong);
  }

  .comparison-table td {
    padding: 1.8rem 2.2rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .comparison-table tr:last-child td {
    border-bottom: none;
  }

  .col-feature {
    width: 28%;
    color: var(--text);
  }

  .col-manual {
    width: 24%;
  }

  .col-hpsr {
    width: 26%;
  }

  .col-ansible {
    width: 22%;
  }

  .featured-header {
    background: var(--accent-subtle) !important;
    color: var(--text) !important;
    position: relative;
    border-left: 1px solid var(--border-accent);
    border-right: 1px solid var(--border-accent);
  }

  .featured-badge {
    display: block;
    width: fit-content;
    font-size: 0.95rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--bg);
    margin-bottom: 4px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .featured-cell {
    background: var(--accent-subtle);
    border-left: 1px solid var(--border-accent);
    border-right: 1px solid var(--border-accent);
    color: var(--text);
    font-weight: 600;
  }

  .cell-feature {
    color: var(--text);
    font-size: 1.45rem;
  }

  .cell-manual {
    color: var(--text-muted);
  }

  .cell-ansible {
    color: var(--text-muted);
  }

  .status-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    margin-right: 8px;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .status-cross {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 999px;
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
    margin-right: 8px;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .status-neutral {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 999px;
    background: rgba(161, 161, 170, 0.15);
    color: var(--text-muted);
    margin-right: 8px;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  /* Corner plus decorations */
  .corner-plus {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
    color: var(--border-accent);
    user-select: none;
    pointer-events: none;
  }

  .corner-tl { top: -5px; left: -4px; }
  .corner-tr { top: -5px; right: -4px; }
  .corner-bl { bottom: -5px; left: -4px; }
  .corner-br { bottom: -5px; right: -4px; }
</style>
