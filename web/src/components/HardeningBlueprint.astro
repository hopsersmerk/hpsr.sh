---
import type { SecurityLayer } from '../lib/content'

interface Props {
  badge: string
  title: string
  description: string
  layers: SecurityLayer[]
}

const { badge, title, description, layers } = Astro.props

const layerIcons: Record<string, string> = {
  admin: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`,
  ssh: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>`,
  ufw: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
  fail2ban: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`,
  updates: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>`,
  audit: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`
}
---

<section class="section blueprint-section" id="blueprint">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-dot"></span>
        <span>{badge}</span>
      </div>
      <h2 class="section-title">{title}</h2>
      <p class="section-description">{description}</p>
    </div>

    <div class="blueprint-grid">
      {layers.map((layer, index) => (
        <article class="blueprint-card" data-layer-card>
          <span class="corner-plus corner-tl" aria-hidden="true">+</span>
          <span class="corner-plus corner-tr" aria-hidden="true">+</span>
          <span class="corner-plus corner-bl" aria-hidden="true">+</span>
          <span class="corner-plus corner-br" aria-hidden="true">+</span>

          <div class="blueprint-card-header">
            <div class="blueprint-icon-wrap" set:html={layerIcons[layer.id] || layerIcons.admin} />
            <span class="blueprint-tag">{layer.tag}</span>
            <span class="blueprint-index">0{index + 1}</span>
          </div>

          <h3 class="blueprint-card-title">{layer.title}</h3>
          <p class="blueprint-card-desc">{layer.description}</p>

          <div class="blueprint-impact">
            <span class="impact-indicator" aria-hidden="true">↳</span>
            <span class="impact-text">{layer.impact}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .blueprint-section {
    position: relative;
    padding: 10rem 0;
  }

  .blueprint-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
    margin-top: 5rem;
  }

  @media (min-width: 768px) {
    .blueprint-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.4rem;
    }
  }

  @media (min-width: 1100px) {
    .blueprint-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blueprint-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 3rem 2.6rem;
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
    background: var(--panel);
    transition: transform var(--transition-medium) var(--bezier-bounce),
                border-color var(--transition-fast) ease,
                background-color var(--transition-fast) ease,
                box-shadow var(--transition-fast) ease;
  }

  .blueprint-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-accent);
    background: var(--panel-hover);
    box-shadow: 0 12px 30px -10px var(--shadow-color);
  }

  .blueprint-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 2rem;
  }

  .blueprint-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.8rem;
    height: 3.8rem;
    border-radius: var(--radius-s);
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid var(--border);
  }

  .blueprint-tag {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .blueprint-index {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--border-accent);
  }

  .blueprint-card-title {
    margin: 0 0 1.2rem;
    font-family: var(--font-sans);
    font-size: 1.85rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text);
  }

  .blueprint-card-desc {
    margin: 0 0 2.4rem;
    font-size: 1.45rem;
    line-height: 1.65;
    color: var(--text-muted);
    flex-grow: 1;
  }

  .blueprint-impact {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius-s);
    background: var(--panel-strong);
    border: 1px solid var(--border);
    margin-top: auto;
  }

  .impact-indicator {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.3rem;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .impact-text {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Corner plus decorations */
  .corner-plus {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
    color: var(--border-accent);
    user-select: none;
    pointer-events: none;
  }

  .corner-tl { top: -5px; left: -4px; }
  .corner-tr { top: -5px; right: -4px; }
  .corner-bl { bottom: -5px; left: -4px; }
  .corner-br { bottom: -5px; right: -4px; }
</style>
