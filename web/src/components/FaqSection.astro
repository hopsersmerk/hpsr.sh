---
import type { FaqItem } from '../lib/content'

interface Props {
  badge: string
  title: string
  description: string
  items: FaqItem[]
}

const { badge, title, description, items } = Astro.props
---

<section class="section faq-section" id="faq">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-dot"></span>
        <span>{badge}</span>
      </div>
      <h2 class="section-title">{title}</h2>
      <p class="section-description">{description}</p>
    </div>

    <div class="faq-list">
      {items.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span class="faq-question-text">{item.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg class="icon-plus" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    position: relative;
    padding: 10rem 0;
  }

  .faq-list {
    max-width: 82rem;
    margin: 5rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .faq-item {
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
    background: var(--panel);
    overflow: hidden;
    transition: border-color var(--transition-fast) ease, background-color var(--transition-fast) ease;
  }

  .faq-item[open] {
    border-color: var(--border-accent);
    background: var(--panel-hover);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    padding: 2.2rem 2.6rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    outline: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .faq-question-text {
    font-family: var(--font-sans);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 999px;
    background: var(--panel-strong);
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform var(--transition-medium) var(--bezier-bounce),
                color var(--transition-fast) ease,
                background-color var(--transition-fast) ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .faq-answer {
    padding: 0 2.6rem 2.4rem;
    border-top: 1px solid transparent;
  }

  .faq-item[open] .faq-answer {
    border-top-color: var(--border);
    padding-top: 1.8rem;
  }

  .faq-answer p {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.7;
    color: var(--text-muted);
  }
</style>
